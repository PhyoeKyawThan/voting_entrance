# Copy to .env and adjust before running:
#   cp .env.example .env
#
# Docker Compose reads .env automatically for ${VAR} substitution in compose files.

# ------------------------------------------------------------------------------
# Django
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Comma-separated origins for HTTPS deployments (required when DEBUG=False)
# Example: https://voting.example.com,https://www.voting.example.com
CSRF_TRUSTED_ORIGINS=

# Set to True when serving over HTTPS behind a reverse proxy
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ------------------------------------------------------------------------------
# Database (MySQL)
# ------------------------------------------------------------------------------
DB_NAME=ve_db_1
DB_USER=dom
DB_PASSWORD=domak
MYSQL_ROOT_PASSWORD=rootpassword

# ------------------------------------------------------------------------------
# Redis (Django Channels)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Docker / production compose
# ------------------------------------------------------------------------------
# Public HTTP port exposed by nginx in production mode
HTTP_PORT=80

# Optional: Arduino serial scanner (host device passthrough only)
# SCANNER_SERIAL_PORT=/dev/ttyUSB0
# SCANNER_SERIAL_BAUDRATE=9600
# SCANNER_SERIAL_TIMEOUT=1.0
